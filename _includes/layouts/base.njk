<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#121212">
<script>try{var t=localStorage.getItem("theme");if(t==="light"){document.documentElement.setAttribute("data-theme","light");var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute("content","#faf9f6");}}catch(e){}</script>
<title>{% if title and title != site.title %}{{ title }} — {% endif %}{{ site.title }}</title>
{% set pageDescription = site.description %}
{% if page.url != "/" %}{% set pageDescription = content | excerpt %}{% endif %}
<meta name="description" content="{{ pageDescription }}">
<meta name="author" content="{{ site.author }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="en" href="https://jonathanmccallum.com{{ page.url }}">
<link rel="alternate" hreflang="ja" href="https://jonathanmccallum-ja.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="hi" href="https://jonathanmccallum-hi.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="pt" href="https://jonathanmccallum-pt.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="id" href="https://jonathanmccallum-id.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="ur" href="https://jonathanmccallum-ur.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="de" href="https://jonathanmccallum-de.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="pcm" href="https://jonathanmccallum-pcm.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="mr" href="https://jonathanmccallum-mr.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="vi" href="https://jonathanmccallum-vi.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="te" href="https://jonathanmccallum-te.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="sw" href="https://jonathanmccallum-sw.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="ha" href="https://jonathanmccallum-ha.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="tr" href="https://jonathanmccallum-tr.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="pnb" href="https://jonathanmccallum-pnb.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="tl" href="https://jonathanmccallum-tl.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="ta" href="https://jonathanmccallum-ta.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="fa" href="https://jonathanmccallum-fa.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="ko" href="https://jonathanmccallum-ko.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="am" href="https://jonathanmccallum-am.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="th" href="https://jonathanmccallum-th.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="jv" href="https://jonathanmccallum-jv.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="it" href="https://jonathanmccallum-it.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="pa" href="https://jonathanmccallum-pa.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="gu" href="https://jonathanmccallum-gu.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="kn" href="https://jonathanmccallum-kn.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="yo" href="https://jonathanmccallum-yo.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="bho" href="https://jonathanmccallum-bho.pages.dev{{ page.url }}">
<link rel="alternate" hreflang="x-default" href="https://jonathanmccallum.com{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{% if title and title != site.title %}{{ title }} — {% endif %}{{ site.title }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if tags and 'posts' in tags %}article{% else %}website{% endif %}">
{% if tags and 'posts' in tags and page.date %}<meta property="article:published_time" content="{{ page.date.toISOString() }}">{% endif %}
{# A post can set shareImage in front matter to use its own photo; otherwise the wave photo. #}
{% set pageShareImage = shareImage or "/images/share.jpg" %}
<meta property="og:image" content="{{ site.url }}{{ pageShareImage }}">
{% if not shareImage %}<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title and title != site.title %}{{ title }} — {% endif %}{{ site.title }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ site.url }}{{ pageShareImage }}">
{% if page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": {{ site.title | dump | safe }},
      "url": {{ site.url | dump | safe }},
      "description": {{ site.description | dump | safe }},
      "inLanguage": "yo"
    },
    {
      "@type": "Person",
      "name": {{ site.author | dump | safe }},
      "url": {{ site.url | dump | safe }},
      "sameAs": [
        "https://www.instagram.com/jonamccallum",
        "https://www.threads.com/@jonamccallum",
        "https://www.youtube.com/@Jonathanmccallum1",
        "https://jonamccallum.substack.com"
      ]
    }
  ]
}
</script>
{% elif tags and 'posts' in tags %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ pageDescription | dump | safe }},
  "url": {{ (site.url + page.url) | dump | safe }},
  "image": {{ (site.url + pageShareImage) | dump | safe }},
{% if page.date %}  "datePublished": {{ page.date.toISOString().slice(0, 10) | dump | safe }},
  "dateModified": {{ page.date.toISOString().slice(0, 10) | dump | safe }},
{% endif %}  "author": { "@type": "Person", "name": {{ site.author | dump | safe }}, "url": {{ site.url | dump | safe }} },
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ (site.url + page.url) | dump | safe }} },
  "inLanguage": "yo"
}
</script>
{% else %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ title | dump | safe }},
  "url": {{ (site.url + page.url) | dump | safe }},
  "description": {{ pageDescription | dump | safe }},
  "inLanguage": "yo"
}
</script>
{% endif %}
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed/">
<link rel="preload" href="/css/style.css?v=12" as="style">
<link rel="stylesheet" href="/css/style.css?v=12">
</head>
<body>
<a class="skip-link" href="#main">Lọ sí àkóónú</a>
<header class="site-header">
  <a class="site-header__title" href="/">Jonathan McCallum</a>
  <button id="theme-toggle" type="button">Dúdú</button>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
    <p>{{ site.title }} — <a href="/feed/">RSS feed</a> · <a href="/search/">Wá</a> · <a href="/privacy/">Ìkọ̀kọ̀</a></p>
  <p>Connect — <a href="https://www.instagram.com/jonamccallum">Instagram</a> · <a href="https://www.threads.com/@jonamccallum">Threads</a> · <a href="https://www.youtube.com/@Jonathanmccallum1">YouTube</a> · <a href="https://jonamccallum.substack.com">Substack</a> · <a href="/feed/">RSS</a></p>
  <p>Built with Eleventy, hosted on Cloudflare Pages.</p>
</footer>
<script src="/js/main.js?v=8" defer></script>
</body>
</html>
